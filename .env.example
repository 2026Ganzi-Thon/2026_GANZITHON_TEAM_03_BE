# mysql 프로필에서 DB_* 환경변수를 읽습니다. IntelliJ 실행 구성/셸에서 주입하세요.
# 이 파일을 복사하는 것만으로 Spring Boot가 자동 로드하지 않습니다.
# 실제 비밀값은 이 파일에 넣지 마세요.
# DB 버전과 접속 방식, JWT 알고리즘·키 형식, Google 연동 방식은 미정입니다.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# JWT를 HMAC 방식으로 정할 경우의 변수 예시. 실제 키 규칙은 알고리즘 결정 후 확정.
JWT_SECRET=

# 아래 JWT·Google·CORS 변수는 향후 구현용 안내이며 아직 연결되지 않았습니다.
# 토큰 수명은 application.yml에 확정 값으로 기록했습니다.
JWT_ACCESS_TOKEN_TTL_SECONDS=3600
JWT_REFRESH_TOKEN_TTL_SECONDS=1209600

GOOGLE_CLIENT_ID=
# 인가 코드 교환 방식을 채택할 때만 서버 시크릿이 필요합니다.
GOOGLE_CLIENT_SECRET=

# 프론트 주소와 허용 Origin은 배포 구성 합의 후 입력합니다.
FRONTEND_URL=
CORS_ALLOWED_ORIGINS=

# 실제 인증 메일 발송용. mysql,smtp 프로필을 함께 사용합니다.
# 개발·자동 테스트용 대체 발송과 달리 시연 환경은 실제 SMTP를 설정합니다.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
# 프론트 인증 화면의 전체 HTTPS 주소 (query·fragment 없이 지정)
EMAIL_VERIFICATION_FRONTEND_URL=
EMAIL_VERIFICATION_IP_MAX_PER_MINUTE=30
