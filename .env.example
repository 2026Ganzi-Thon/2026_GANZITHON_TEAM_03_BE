# 환경변수 이름 제안입니다. 현재 이를 읽는 애플리케이션은 없습니다.
# Spring Boot 초기화 PR에서 IntelliJ/셸 주입과 application 설정 매핑을 구현하세요.
# 실제 비밀값은 이 파일에 넣지 마세요.
# DB 버전과 접속 방식, JWT 알고리즘·키 형식, Google 연동 방식은 미정입니다.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# JWT를 HMAC 방식으로 정할 경우의 변수 예시. 실제 키 규칙은 알고리즘 결정 후 확정.
JWT_SECRET=

# 확정된 토큰 수명. Refresh Token 회전 시 발급 시점부터 다시 14일.
JWT_ACCESS_TOKEN_TTL_SECONDS=3600
JWT_REFRESH_TOKEN_TTL_SECONDS=1209600

GOOGLE_CLIENT_ID=
# 인가 코드 교환 방식을 채택할 때만 서버 시크릿이 필요합니다.
GOOGLE_CLIENT_SECRET=

# 프론트 주소와 허용 Origin은 배포 구성 합의 후 입력합니다.
FRONTEND_URL=
CORS_ALLOWED_ORIGINS=
