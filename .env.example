# mysql 프로필에서 DB_* 환경변수를 읽습니다. IntelliJ 실행 구성/셸에서 주입하세요.
# 이 파일을 복사하는 것만으로 Spring Boot가 자동 로드하지 않습니다.
# 실제 비밀값은 이 파일에 넣지 마세요.
# DB 접속값은 mysql, 인증값은 auth 프로필에서 읽습니다.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# auth 프로필 필수. 32바이트 이상 무작위 키의 Base64 값. 실제 값 커밋 금지.
JWT_SECRET_BASE64=
GOOGLE_CLIENT_ID=
# 쉼표로 구분한 정확한 프론트 Origin, 끝에 / 없이 입력
CORS_ALLOWED_ORIGINS=
# 같은 site는 Lax, 다른 site는 None 검토. Secure는 항상 적용.
AUTH_COOKIE_SAME_SITE=Lax
# 실제 프론트 약관 문서 버전과 동일하게 설정
TERMS_VERSION=
PRIVACY_VERSION=
MARKETING_VERSION=
# Access 1시간, Refresh는 매 발급 시점부터 14일로 구현되어 있습니다.
# GIS ID Token 검증 방식이므로 GOOGLE_CLIENT_SECRET은 사용하지 않습니다.

# 실제 인증 메일 발송용. mysql,smtp 프로필을 함께 사용합니다.
# 개발·자동 테스트용 대체 발송과 달리 시연 환경은 실제 SMTP를 설정합니다.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
# 프론트 인증 화면의 전체 HTTPS 주소 (query·fragment 없이 지정)
EMAIL_VERIFICATION_FRONTEND_URL=
EMAIL_VERIFICATION_IP_MAX_PER_MINUTE=30

# 비밀번호 재설정 화면의 전체 HTTPS 주소 (query·fragment 없이 지정)
PASSWORD_RESET_FRONTEND_URL=
