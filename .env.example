# mysql 프로필에서 DB_* 환경변수를 읽습니다. IntelliJ 실행 구성/셸에서 주입하세요.
# 이 파일을 복사하는 것만으로 Spring Boot가 자동 로드하지 않습니다.
# 실제 비밀값은 이 파일에 넣지 마세요.
# 실제 가입·로그인을 함께 사용하려면 mysql,auth,smtp를 활성화합니다.
SPRING_PROFILES_ACTIVE=mysql,auth,smtp

# QR 시연용 프론트 HTTPS Origin. 끝에 /를 붙이지 않습니다.
# 로컬 예: http://localhost:5173
# CORS 및 인증 링크(/verify-email, /reset-password)의 기본값에 사용됩니다.
FRONTEND_ORIGIN=

# DB 접속값은 mysql, 인증값은 auth 프로필에서 읽습니다.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# auth 프로필 필수. 32바이트 이상 무작위 키의 Base64 값. 실제 값 커밋 금지.
JWT_SECRET_BASE64=
GOOGLE_CLIENT_ID=
# FRONTEND_ORIGIN 대신 여러 Origin을 허용할 때만 설정합니다.
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://preview.example.com
# 같은 site는 Lax, 다른 site는 None 검토. Secure는 항상 적용.
AUTH_COOKIE_SAME_SITE=Lax
# 실제 프론트 약관 문서 버전과 동일하게 설정
TERMS_VERSION=
PRIVACY_VERSION=
MARKETING_VERSION=
# Access 1시간, Refresh는 매 발급 시점부터 14일로 구현되어 있습니다.
# GIS ID Token 검증 방식이므로 GOOGLE_CLIENT_SECRET은 사용하지 않습니다.

# 실제 인증 메일 발송용. mysql,smtp 프로필을 함께 사용합니다.
# 개발·자동 테스트용 대체 발송과 달리 시연 환경은 실제 SMTP를 설정합니다.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
# 실제 인증 화면 경로가 /verify-email과 다를 때 전체 URL로 덮어씁니다.
# EMAIL_VERIFICATION_FRONTEND_URL=https://app.example.com/account/verify-email
EMAIL_VERIFICATION_IP_MAX_PER_MINUTE=30

# 실제 비밀번호 재설정 경로가 /reset-password와 다를 때 전체 URL로 덮어씁니다.
# PASSWORD_RESET_FRONTEND_URL=https://app.example.com/account/reset-password
